# ProductBay Development Environment Configuration
# =================================================
# Copy this file to .env and adjust values for your local environment.
# The .env file should NOT be committed to version control.

# Development Mode
# When true: enqueued assets are versioned with their file modification time,
# so a file you just edited is never served stale while untouched files stay
# cached.
# When false or omitted: assets are versioned with the plugin version, or the
# build's content hash where there is one. That is identical on every server
# and changes only when the bytes change.
PRODUCTBAY_DEV_MODE=false
